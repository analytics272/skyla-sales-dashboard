# Local dev: point at the downloaded service account JSON key (never commit the real file)
GOOGLE_APPLICATION_CREDENTIALS=./your-service-account-key.json

# Vercel/production: base64 of the full service account JSON instead of a file path
# GCP_SERVICE_ACCOUNT_KEY_B64=

BIGQUERY_PROJECT_ID=skyla-analytics
BIGQUERY_DATASET=Skyla_Sales_Automation

# Shared login gate (PRD §4) - single username/password for the whole dashboard
# IMPORTANT: Next.js's built-in env loader (@next/env) does dotenv-expand-style
# "$VAR" interpolation, which silently mangles bcrypt hashes (they contain
# literal "$" chars, e.g. "$2b$12$..."). Escape every "$" as "\$" in this file
# or the hash resolves to an empty string and login always fails with no
# obvious error beyond "Server auth is not configured".
SHARED_USERNAME=
SHARED_PASSWORD_HASH=
SESSION_SECRET=
